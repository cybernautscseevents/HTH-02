# Backend settings, read from a repo-root .env (gitignored). Variables already exported win.
# HC03_LLM_PROVIDER=groq
# Use one key, or a comma-separated rotation. Keys are tried in order after HTTP 429.
# HC03_LLM_API_KEY=
# HC03_LLM_API_KEYS=key-1,key-2

# Clinical default is 48 hours. Use one minute only for a time-compressed demonstration.
# HC03_TIMEOUT_MINUTES=1
